        "valid": true,
        "menulabel": "RPR",
        "menupriority": 0,
        "restartrendersettings": [
            "rpr:core:renderQuality"
        ],
        "pauseonupdate": false,
        "allowbackgroundupdate": true,
        "viewstats": [
