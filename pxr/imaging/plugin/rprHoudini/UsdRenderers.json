        ],
        "statsdatapaths": {
            "totalClockTime": "frameRenderTotalTime",
            "percentDone": "percentDone",
            "renderProgressAnnotation": "renderProgressAnnotation",
            "Render GPU": "gpuUsedNames",
            "CPU render threads": "threadCountUsed",
            "Samples per second": "samplesPerSecond",
            "Output resolution": "outputResolution",
            "RPR preview scale": "previewScale"
        }
    }
}
